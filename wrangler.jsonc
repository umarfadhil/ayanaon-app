{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ayanaon",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AYAKASIR_ORDER_URL_PREFIX": "https://ayakasir.petalytix.id/"
  },
  "secrets": {
    "required": [
      "MONGODB_URI",
      "JWT_SECRET",
      "MONGODB_DASHBOARD_PASSWORD",
      "AYAKASIR_PARTNER_SECRET",
      "APIFY_API_TOKEN",
      "APIFY_GATHER_ACTOR_ID",
      "GOOGLE_MAPS_BROWSER_API_KEY",
      "GOOGLE_GEOCODING_API_KEY"
    ]
  },
  "alias": {
    "kerberos": "./src/mongodb-optional-native-stub.js",
    "mongodb-client-encryption": "./src/mongodb-optional-native-stub.js"
  },
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true
}
